{
  "name": "spectrum",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run validate && npm run derive && npm run lint && npm run typecheck && npm run test",
    "gen:index": "tsx scripts/gen-catalog-index.ts",
    "validate": "tsx scripts/validate-data.ts",
    "derive": "tsx scripts/build-derived.ts",
    "calibration": "tsx scripts/calibration-report.ts",
    "check-sources": "tsx scripts/check-sources.ts",
    "prebuild": "npm run validate && npm run derive",
    "export:questions": "tsx scripts/export-questions.ts"
  },
  "dependencies": {
    "next": "^16.4.2",
    "next-intl": "^4.14.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.2",
    "eslint-plugin-i18next": "^6.1.5",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
