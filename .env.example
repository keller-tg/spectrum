# Copy to .env.local for development. Never commit real values — this repo is public.

# Privacy guard (scripts/check-privacy.ts): SHA-256 hex of the owner's lowercase email and of
# its local part, comma-separated. Hashes only, never the address. Also a GitHub Actions secret.
PRIVACY_GUARD_SHA256=

# Public base URL (used for canonical URLs, hreflang and OG images)
NEXT_PUBLIC_SITE_URL=https://spectrum-six-rho.vercel.app

# --- Opt-in encrypted sync (Phase 7) ---
FEATURE_SYNC=0
DATABASE_URL=
# 32+ random bytes, base64 (e.g. `openssl rand -base64 32`)
TOKEN_PEPPER=
RATE_LIMIT_SECRET=
CRON_SECRET=

# --- Optional features (Phase 11) ---
FEATURE_AI=0
ANTHROPIC_API_KEY=
FEATURE_COMMUNITY=0
